{
  "name": "betterfy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "npm run build && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "visual:check": "node scripts/visual-check.mjs",
