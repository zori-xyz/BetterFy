{
  "name": "betterfy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "site:dev": "vite --config website/vite.config.ts",
    "site:build": "tsc -p website/tsconfig.json && vite build --config website/vite.config.ts",
    "site:check": "node scripts/site-check.mjs",
    "site:preview": "vite preview --config website/vite.config.ts",
    "check": "npm run build && npm run icon:check && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "visual:check": "node scripts/visual-check.mjs",
    "icon:placeholder": "node scripts/render-placeholder-icon.mjs && tauri icon src-tauri/icons/icon-source.png && npm run icon:check",
    "icon:check": "node scripts/verify-windows-icon.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.57.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
