{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterFy",
  "version": "0.1.0",
  "identifier": "app.betterfy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BetterFy",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://betterfy-auth.zori-xyz.workers.dev; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false,
      "nsis": {
        "template": "windows/installer.nsi",
        "headerImage": "windows/installer/header.bmp",
        "sidebarImage": "windows/installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "windows/installer/header.bmp",
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "BetterFy"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RjYxQTkzNTQxRDZFOTAKUldTUWJoMVVreHIyS2ZaRWFUVllzVGVUUElzM3UzU3pROXRRM0RsUGVzSGRUNXJBOWY1Q041c2UK",
      "endpoints": [
        "https://github.com/zori-xyz/BetterFy/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
