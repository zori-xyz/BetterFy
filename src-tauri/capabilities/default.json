{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "BetterFy desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://t.me/BeterFyBot?start=auth_*" },
        { "url": "https://zori-xyz.github.io/BetterFy/" }
      ]
    }
  ]
}
